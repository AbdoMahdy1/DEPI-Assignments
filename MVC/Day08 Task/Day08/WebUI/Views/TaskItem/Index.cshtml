@model IEnumerable<Core.Models.TaskItem>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create"><btn class=" btn btn-success mt-3">Create New</btn></a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsCompleted)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IsCompleted)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CreatedAt)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id"><btn class=" btn btn-secondary mt-3">Edit</btn></a>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id"><btn class=" btn btn-primary mt-3">Details</btn></a>
                </td>
                <td>
                    <a asp-action="Delete" asp-route-id="@item.Id"><btn class="btn btn-danger mt-3">Delete</btn></a>
                </td>
            </tr>
        }
    </tbody>
</table>
