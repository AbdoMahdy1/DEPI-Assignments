@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to School Management System</h1>
    <p>Manage your school data efficiently with our comprehensive management system.</p>
</div>

<div class="row mt-5">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title">Students</h5>
                <p class="card-text">Manage student information, grades, and enrollment.</p>
                <a asp-controller="Student" asp-action="ShowAll" class="btn btn-primary">View Students</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title">Courses</h5>
                <p class="card-text">Manage course information, degrees, and requirements.</p>
                <a asp-controller="Course" asp-action="ShowAll" class="btn btn-primary">View Courses</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title">Departments</h5>
                <p class="card-text">Manage department information and organization.</p>
                <a asp-controller="Department" asp-action="ShowAll" class="btn btn-primary">View Departments</a>
            </div>
        </div>
    </div>
</div>
