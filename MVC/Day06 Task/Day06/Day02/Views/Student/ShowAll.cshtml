@model List<Student>
<h1>Students</h1>
<a asp-controller="Student" asp-action="Add"><btn class="btn btn-success mt-3 mb-3">New</btn></a>
<table class="table table-bordered table-hover">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Age</th>
        <th>DepartmentId</th>
        <th>Actions</th>
    </tr>

    @foreach(var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Age</td>
            <td>@item.DepartmentId</td>
            <td>
                <a asp-controller="Student" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                <a asp-controller="Student" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
            </td>
        </tr>
    }
</table>

<div class="mt-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to Home</a>
    <a asp-controller="Course" asp-action="ShowAll" class="btn btn-secondary">View Courses</a>
    <a asp-controller="Department" asp-action="ShowAll" class="btn btn-secondary">View Departments</a>
</div>
