@model Day02.Models.Course

@{
    ViewData["Title"] = "Delete Course";
}

<h1>Delete Course</h1>

<div class="alert alert-warning">
    <h4>Are you sure you want to delete this course?</h4>
</div>

<div class="card">
    <div class="card-header">
        <h3>@Model.Name</h3>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Course ID:</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Course Name:</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Course Degree:</dt>
            <dd class="col-sm-9">@Model.Degree</dd>

            <dt class="col-sm-3">Minimum Degree:</dt>
            <dd class="col-sm-9">@Model.MinDegree</dd>

            <dt class="col-sm-3">Department:</dt>
            <dd class="col-sm-9">@Model.Department?.Name</dd>
        </dl>
    </div>
</div>

<form asp-action="ConfirmDeletion" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="ShowAll" class="btn btn-secondary">Cancel</a>
    </div>
</form>
