@model List<Day02.Models.Course>

@{
    ViewData["Title"] = "All Courses";
}

<h1>All Courses</h1>

<p>
    <a asp-action="Add" class="btn btn-primary">Add New Course</a>
</p>

<!-- Student Course Results Form -->
<div class="card mb-4">
    <div class="card-header">
        <h5>View Student Course Results</h5>
    </div>
    <div class="card-body">
        <form asp-controller="Course" asp-action="StudentCourseResults" method="get" class="row g-3">
            <div class="col-md-4">
                <label for="studentId" class="form-label">Student ID:</label>
                <input type="number" id="studentId" name="studentId" class="form-control" required min="1" />
            </div>
            <div class="col-md-4">
                <label for="courseId" class="form-label">Course ID:</label>
                <input type="number" id="courseId" name="courseId" class="form-control" required min="1" />
            </div>
            <div class="col-md-4">
                <label class="form-label">&nbsp;</label>
                <div>
                    <button type="submit" class="btn btn-info">View Results</button>
                </div>
            </div>
        </form>
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Course Name</th>
            <th>Degree</th>
            <th>Min Degree</th>
            <th>Department</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var course in Model)
        {
            <tr>
                <td>@course.Id</td>
                <td>@course.Name</td>
                <td>@course.Degree</td>
                <td>@course.MinDegree</td>
                <td>@course.Department?.Name</td>
                <td>
                    <a asp-action="ShowDetails" asp-route-id="@course.Id" class="btn btn-info btn-sm">Details</a>
                    <a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@course.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to Home</a>
    <a asp-controller="Student" asp-action="ShowAll" class="btn btn-secondary">View Students</a>
    <a asp-controller="Department" asp-action="ShowAll" class="btn btn-secondary">View Departments</a>
</div>
