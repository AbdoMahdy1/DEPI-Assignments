@model List<Department>

<h1>Departments</h1>
<a href="/Department/Add" class="btn btn-success mt-3 mb-3">New</a>
<table class="table table-hover table-bordered">
    <tr>
        <th>DeptId</th>
        <th>DeptName</th>
        <th>StCount</th>
        <th>Actions</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Students?.Count</td>
            <td>
                <a asp-controller="Department" asp-action="ShowDetails" asp-route-id="@item.Id" class="btn btn-info btn-sm">Details</a>
            </td>
        </tr>
    }
</table>

<div class="mt-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to Home</a>
    <a asp-controller="Student" asp-action="ShowAll" class="btn btn-secondary">View Students</a>
    <a asp-controller="Course" asp-action="ShowAll" class="btn btn-secondary">View Courses</a>
</div>