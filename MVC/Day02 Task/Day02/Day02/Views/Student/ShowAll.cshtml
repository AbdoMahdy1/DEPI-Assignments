@model List<Student>
<h1>Students</h1>

<table class="Students table-bordered table-hover">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Age</th>
        <th>DepartmentId</th>
    </tr>

    @foreach(var item in Model)
    {
    <tr>
        <td>@item.Id</td>
        <td>@item.Name</td>
        <td>@item.Age</td>
        <td>@item.DepartmentId</td>
    </tr>
    }
</table>
