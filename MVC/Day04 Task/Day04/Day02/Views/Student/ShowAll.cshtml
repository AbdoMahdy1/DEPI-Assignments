@model List<Student>
<h1>Students</h1>
<a asp-controller="Student" asp-action="Add"><btn class="btn btn-success mt-3 mb-3">New</btn></a>
<table class="table table-bordered table-hover">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Age</th>
        <th>DepartmentId</th>
    </tr>

    @foreach(var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Age</td>
            <td>@item.DepartmentId</td>
            <td><a asp-controller="Student" asp-action="Edit" asp-route-id="@item.Id">Edit</a></td>
            <td><a asp-controller="Student" asp-action="Delete" asp-route-id="@item.Id">Delete</a></td>
        </tr>
    }
</table>
