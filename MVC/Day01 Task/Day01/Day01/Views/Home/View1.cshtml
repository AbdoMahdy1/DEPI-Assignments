<h1>Hello World!</h1>

<style>
    h1{
        color: purple;
    }
</style>

<script>
    console.log("Abdo");
</script>

@{
    int n1 = 30, n2 = 15;
}

<h3>N1 = @n1, N2 = @n2</h3>

@{
    if (n1 > n2)
    {
        <h3>N1 is greater than N2</h3>
    }

    else
    {
        <h3>N1 is greater than N2</h3>
    }

}

@{
    <h3>Numbers from 1 to 10</h3>

    for(int i = 1; i <= 10; i++)
    {
        <li>@i</li>
    }
}